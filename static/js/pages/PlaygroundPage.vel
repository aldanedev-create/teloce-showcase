<template>
  <main class="playground"><nav class="nav"><a class="brand" href="#/">Teloce<span>Motion</span></a><a href="#/tutorial">Tutorial &rarr;</a></nav><section class="panel"><p class="eyebrow">Router playground</p><h1>You are on <code>{{ path }}</code></h1><p>Change the hash in the address bar or use the links below. Teloce updates the component without a full page reload.</p><div class="route-links"><a href="#/">Home</a><a href="#/tutorial">Tutorial</a><a href="#/playground">Playground</a></div><div class="readout"><span>Reactive route</span><strong>{{ path }}</strong></div></section></main>
</template>
<script>
export default {
  data() { return { path: window.location.hash.slice(1) || "/" }; },
  mounted() { this.sync = () => { this.path = window.location.hash.slice(1) || "/"; }; window.addEventListener("hashchange", this.sync); },
  beforeUnmount() { window.removeEventListener("hashchange", this.sync); }
};
</script>
<style scoped>
* { box-sizing: border-box; } .playground { min-height: 100vh; padding: 1.25rem max(1.25rem, calc((100% - 74rem) / 2)); background: #07121c; color: #eefaff; font: 1rem/1.5 system-ui, sans-serif; } .nav { display: flex; justify-content: space-between; max-width: 74rem; margin: auto; padding: .8rem 0; } .brand { color: #fff; font-weight: 800; text-decoration: none; } .brand span { color: #72e6d0; } a { color: #8dded0; text-decoration: none; } .panel { max-width: 55rem; margin: 13vh auto 0; padding: clamp(1.5rem, 6vw, 4rem); border: 1px solid #294557; border-radius: 1.5rem; background: linear-gradient(145deg, #112737, #0d1b28); box-shadow: 0 2rem 5rem #0006; } .eyebrow { color: #72e6d0; font-size: .72rem; font-weight: 800; letter-spacing: .16em; text-transform: uppercase; } h1 { margin: .8rem 0 1rem; font-size: clamp(2.3rem, 7vw, 5rem); letter-spacing: -.07em; } code { color: #ffb8df; } .panel > p { max-width: 38rem; color: #a5bbca; } .route-links { display: flex; flex-wrap: wrap; gap: .7rem; margin: 2rem 0; } .route-links a { padding: .7rem 1rem; border: 1px solid #3c6476; border-radius: .7rem; background: #173344; } .readout { display: flex; justify-content: space-between; gap: 1rem; padding-top: 1rem; border-top: 1px solid #294557; color: #7e99aa; } .readout strong { color: #72e6d0; } @media (max-width: 34rem) { .readout { align-items: flex-start; flex-direction: column; } }
</style>
